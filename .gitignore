# .gitignore for the bianca / bookish-waffle analysis repo
#
# This repo tracks the *reported* results only: the README, the analysis
# scripts behind it, and the figures and tables it links to. Everything else
# in this working tree — 36 GB of raw reads, the reference genome, BAMs, and
# all regenerable pipeline output — stays local.
#
# Note: .gitignore does not affect files that are already tracked. Adding a
# pattern here will not remove anything from the repo. To commit a new file
# that matches one of these rules, use `git add -f <path>`.

# ---------------------------------------------------------------
# Bulk sequence data
# ---------------------------------------------------------------
raw_reads/
references/
augustus/
NCBI_Ssci_genome.fa

# Reads, assemblies, alignments, indices, coverage tracks
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fa
*.fa.gz
*.fasta
*.fasta.gz
*.bam
*.bam.bai
*.bai
*.cram
*.crai
*.bigWig
*.bw

# ---------------------------------------------------------------
# Nextflow
# ---------------------------------------------------------------
.nextflow/
.nextflow.log*
work/
run_nextflow.sh.bak

# nf-core/rnaseq pipeline checkout — upstream source, not our results
rnaseq/assets/
rnaseq/bin/
rnaseq/conf/
rnaseq/docs/
rnaseq/modules/
rnaseq/subworkflows/
rnaseq/workflows/
rnaseq/tests/
